{
  "health": {
    "enabled": false,
    "path": "/health",
    "method": "GET",
    "interval_seconds": 10,
    "timeout_seconds": 2,
    "failures_to_down": 3,
    "successes_to_up": 2
  },
  "routes": [
    {
      "prefix": "/finance/",
      "target": "http://127.0.0.1:9001"
    },
    {
      "prefix": "/report/",
      "targets": [
        {"url": "http://127.0.0.1:9002", "weight": 2},
        {"url": "http://127.0.0.1:9003", "weight": 1}
      ],
      "add_prefix": "/api",
      "methods": ["GET", "POST"],
      "cooldown_seconds": 5
    },
    {
      "prefix": "/live/",
      "target": "http://127.0.0.1:9004",
      "websocket": true,
      "health": {"path": "/livez", "interval_seconds": 5}
    }
  ]
}
