# demo: 无需密钥的演示；openai: 调用兼容 OpenAI Chat Completions 的接口。
GATEWAY_PROVIDER=demo
GATEWAY_TOKEN=
GATEWAY_DB_PATH=data/gateway.sqlite3

# 认证模式：legacy 只认上面的共享 token；local 启用本地账号 + 会话 Cookie（旧 token 仍可用）。
# 首次启用 local 后先建管理员：python -m gateway.admin create-user --username admin --admin
GATEWAY_AUTH_MODE=legacy
GATEWAY_SESSION_IDLE_SECONDS=28800
GATEWAY_SESSION_ABSOLUTE_SECONDS=604800
GATEWAY_COOKIE_SECURE=false
GATEWAY_LOGIN_MAX_FAILURES=5
GATEWAY_LOGIN_WINDOW_SECONDS=300
GATEWAY_LOGIN_LOCK_SECONDS=900

# 切换为 openai 时，填写服务商的地址、密钥和实际模型名称。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=demo
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=2048

# 模型上下文窗口大小（提示词 + 回答）。历史超出预算时，会从最旧的一轮对话开始省略；
# 本机小模型常见 8192，云端大窗口模型可以调大。
MODEL_CONTEXT_TOKENS=8192

# 是否让模型请求走系统代理。默认 false 直连，访问本机或内网模型服务时必须保持 false；
# 需要经代理访问远程服务时再改为 true。
MODEL_USE_SYSTEM_PROXY=false

# 可选的反向代理：把其他本地服务挂到同一个入口下。
# 路由表文件不存在表示不启用；格式见 routes.json.example。
GATEWAY_ROUTES_PATH=routes.json
GATEWAY_PROXY_TIMEOUT=30

# 结构化日志（JSON Lines）：按 access/app/proxy/auth/audit 分类，被代理的服务再按服务名分目录。
GATEWAY_LOG_ENABLED=true
GATEWAY_LOG_DIR=D:\Document\logs\ydd-gateway
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_STDOUT=false
# 是否记录请求参数；正文只记前 N 个字符（0 表示只记长度），敏感字段一律打码。
GATEWAY_LOG_PARAMS=true
GATEWAY_LOG_CONTENT_PREVIEW=200
GATEWAY_LOG_PARAM_MAX_BYTES=65536
GATEWAY_LOG_MAX_BYTES=52428800
GATEWAY_LOG_BACKUP_DAYS=30
GATEWAY_AUDIT_BACKUP_DAYS=180
